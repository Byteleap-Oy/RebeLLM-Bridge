{
  "name": "rebellm-bridge",
  "version": "0.1.0",
  "description": "Use the model running in your RebeLLM browser tab from Claude Code (as its model or through MCP) and any OpenAI-style client",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rebellm-bridge": "dist/cli.js",
    "rebellm-claude": "dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  }
}
