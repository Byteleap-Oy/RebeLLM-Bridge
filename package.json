{
  "name": "rebellm-bridge",
  "version": "0.1.3",
  "description": "Use the model in your RebeLLM browser tab from the command line, OpenAI/Anthropic clients and Claude Code",
  "keywords": [
    "rebellm",
    "llm",
    "bridge",
    "mcp",
    "claude-code",
    "openai-compatible",
    "anthropic-compatible",
    "webgpu"
  ],
  "author": "Byteleap Oy",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://rebellm.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Byteleap-Oy/RebeLLM-Bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Byteleap-Oy/RebeLLM-Bridge/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "rebellm-bridge": "dist/cli.js",
    "rebellm-claude": "dist/launcher.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prepublishOnly": "npm run check && npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@eslint/js": "^10.0.1",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^4.0.0"
  }
}
